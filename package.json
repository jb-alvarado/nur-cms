{
  "name": "frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && npm run build-only --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "lint": "cd frontend && eslint src --fix",
    "format": "prettier --write frontend/src/",
    "dev:example": "vite --config vite.example.config.ts",
    "build:example": "vite build --config vite.example.config.ts"
  },
  "dependencies": {
    "@unhead/vue": "^3.4.3",
    "@videojs/html": "^10.3.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "bootstrap-icons": "^1.13.2",
    "dayjs": "^1.11.23",
    "es-toolkit": "^1.53.2",
    "jwt-decode": "^4.0.0",
    "pinia": "^4.1.0",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.18",
    "vue-multiselect": "^3.5.0",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/node24": "^24.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "daisyui": "^5.7.50",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "~10.12.1",
    "jiti": "^2.7.0",
    "prettier": "3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
