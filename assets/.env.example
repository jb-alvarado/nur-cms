DATABASE_URL=postgres://postgres:nuR1234@127.0.0.1/nur_cms
STORAGE=/var/www/nur-cms/uploads

# Optional listen to.
# LISTEN=127.0.0.1:8777

# Disable two factor authentication
# DISABLE_TWO_FACTOR=false

# Short-lived access tokens reduce the window after role changes or logout.
ACCESS_LIFETIME_MINUTES=15
REFRESH_LIFETIME=30

# Upload and image-processing resource limits.
MAX_UPLOAD_SIZE=838860800
MAX_CHUNK_SIZE=10485760
MAX_ACTIVE_UPLOADS_PER_USER=4
UPLOAD_TTL_SECONDS=86400
MAX_IMAGE_PIXELS=40000000
IMAGE_PROCESSING_CONCURRENCY=2

# Process-local cache for public content entry responses. Set to 0 to disable it.
NUR_ENTRY_CACHE=1
# Maximum number of cached public entry, list, and facet responses.
NUR_ENTRY_CACHE_CAPACITY=512
# Expire inactive responses after 30 minutes and all responses after one day.
NUR_ENTRY_CACHE_TTI_SECONDS=1800
NUR_ENTRY_CACHE_TTL_SECONDS=86400

# Comma-separated plugin IDs to enable. Installed plugins are disabled by default.
# NUR_PLUGINS=echo
# Additional plugin package roots, separated using the platform path separator.
# NUR_PLUGIN_DIR=/usr/share/nur-cms/plugins:/var/lib/nur-cms/plugins
# Allow explicitly declared routes outside /api/plugins/<plugin-id>.
NUR_PLUGIN_ALLOW_ROOT_ROUTES=0
NUR_PLUGIN_FUEL=1000000
NUR_PLUGIN_MEMORY_LIMIT=67108864
NUR_PLUGIN_MODULE_SIZE_LIMIT=67108864
NUR_PLUGIN_TIMEOUT_MS=5000
NUR_PLUGIN_MAX_CONCURRENCY=8
NUR_PLUGIN_MAX_HOST_CALLS=16
NUR_PLUGIN_REQUEST_BODY_LIMIT=1048576
NUR_PLUGIN_RESPONSE_BODY_LIMIT=4194304

# Development only: explicitly opt in to the insecure admin/admin bootstrap.
# NUR_DEV_AUTO_ADMIN=1

# Development only: run migrations_dev/0001_fill_database.sql on an empty media database.
# NUR_DEV_SEED_DATABASE=1

# Comma-separated CIDRs of reverse proxies allowed to supply X-Forwarded-For
# or X-Real-IP. Leave empty when the application is reached directly.
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,10.0.0.0/8
