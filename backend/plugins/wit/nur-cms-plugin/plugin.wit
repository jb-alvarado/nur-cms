package nur:cms@0.1.0;

interface types {
  record header {
    name: string,
    value: string,
  }

  record identity {
    user-id: s32,
    roles: list<string>,
  }

  record path-param {
    name: string,
    value: string,
  }

  record request {
    route-id: string,
    method: string,
    path: string,
    path-params: list<path-param>,
    query: option<string>,
    headers: list<header>,
    body: list<u8>,
    identity: option<identity>,
  }

  record response {
    status: u16,
    headers: list<header>,
    body: list<u8>,
  }

  variant plugin-error {
    bad-request(string),
    rate-limited,
    forbidden,
    not-found,
    failed(string),
  }
}

interface http-handler {
  use types.{request, response, plugin-error};
  handle: func(request: request) -> result<response, plugin-error>;
}

interface content {
  use types.{plugin-error};

  variant output-type {
    markdown,
    ast,
    html,
  }

  /// Executes an entry-list query with the same filters and fields as the public
  /// `/api/content/entries` endpoint. Entries are always restricted to `published`.
  published-entries: func(query: string, output: output-type) -> result<list<u8>, plugin-error>;
}

interface database {
  use types.{plugin-error};

  enum null-type {
    boolean,
    integer,
    float,
    text,
    bytes,
    json,
  }

  variant value {
    null(null-type),
    boolean(bool),
    integer(s64),
    float(f64),
    text(string),
    bytes(list<u8>),
    json(string),
  }

  record statement {
    sql: string,
    params: list<value>,
  }

  record query-result {
    rows-affected: u64,
    columns: list<string>,
    rows: list<list<value>>,
  }

  /// Executes one parameterized DML statement in the calling plugin's schema.
  execute: func(statement: statement) -> result<query-result, plugin-error>;

  /// Executes all statements atomically. A failing statement rolls back every prior statement.
  transaction: func(statements: list<statement>) -> result<list<query-result>, plugin-error>;
}

interface mail {
  use types.{plugin-error};

  record message {
    target: string,
    name: string,
    reply-to: string,
    subject: option<string>,
    text: string,
  }

  /// Sends through a configured CMS mail target without exposing SMTP credentials.
  send: func(message: message) -> result<_, plugin-error>;
}

world cms-plugin {
  import content;
  import database;
  import mail;
  export http-handler;
}
